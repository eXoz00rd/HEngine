# HEngine .gitignore
# Generated for a .NET 9 multi-project solution targeting Windows with JetBrains Rider/Visual Studio
# Date: 2025-08-26

############################
# OS-specific junk
############################
# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.stackdump
# macOS (in case of cross-platform devs)
.DS_Store
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes

############################
# IDEs and editors
############################
# JetBrains Rider / IntelliJ
.idea/
*.iml
# Rider/Resharper caches
_ReSharper*/
*.DotSettings.user
*.sln.DotSettings.user

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# VS Code (project-specific files may be shared, but generally ignore workspace-local settings)
.vscode/

# Other editors
*.userprefs

############################
# .NET build outputs
############################
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
out/
artifacts/
# dotnet publish output is under bin/**/publish which is covered by bin/, but keep explicit rule
publish/

############################
# NuGet & packages
############################
# Global packages not stored in repo
.nuget/packages/
# Local packages folder (legacy)
packages/
# Package artifacts
*.nupkg
*.snupkg
# NuGet v3 cache
~/.nuget/

############################
# Testing & Coverage
############################
TestResults/
*.trx
*.coverage
*.coveragexml
coverage/
.coverage/
.opencover/
*.opencover.xml
BenchmarkDotNet.Artifacts/

############################
# Logs and diagnostics
############################
*.log
*.etl
*.dmp
*.diag

############################
# Temporary files
############################
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo

############################
# Rider local caches for solution-wide analysis
############################
.idea/.idea.*/
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/dictionaries/
.idea/**/shelf/

# End of .gitignore


############################
# Local tooling (not part of the repo)
############################
.junie/
